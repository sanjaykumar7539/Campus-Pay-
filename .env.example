# Local evaluation only. main.py loads this file from the project root.
ENVIRONMENT=local
DATABASE_URL=sqlite:///./campuspay_demo.db
# Set a randomly generated secret; no shared default is supplied.
SECRET_KEY=
CAMPUSPAY_PAYMENT_AUTH=fingerprint
CAMPUSPAY_DEMO_FUNDING=false
CAMPUSPAY_LEGACY_MANUAL_PAYMENT=false
CAMPUSPAY_ACCESS_TOKEN_MINUTES=60
CAMPUSPAY_BCRYPT_ROUNDS=12
CAMPUSPAY_HOST=127.0.0.1
API_PORT=8000
