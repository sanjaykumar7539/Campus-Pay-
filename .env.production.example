# Template only. Supply real values through the deployment secret manager.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://campuspay:REPLACE_PASSWORD@db:5432/campuspay
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CAMPUSPAY_ALLOWED_HOSTS=pay.example.edu
CAMPUSPAY_PAYMENT_AUTH=fingerprint
CAMPUSPAY_DEMO_FUNDING=false
CAMPUSPAY_LEGACY_MANUAL_PAYMENT=false
